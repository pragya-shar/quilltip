# Local Next.js environment. Copy to .env.local; keep real credentials out of Git.
# `bunx convex dev --once` writes these values for the selected dev deployment:
# CONVEX_DEPLOYMENT=dev:your-deployment
# NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Optional payment features: fill in valid IDs/addresses for the intended testnet.
# The unified tipping contract handles article AND highlight tips.
NEXT_PUBLIC_TIPPING_CONTRACT_ID=
NEXT_PUBLIC_NFT_CONTRACT_ID=
NEXT_PUBLIC_PLATFORM_ADDRESS=
NEXT_PUBLIC_STELLAR_NETWORK=TESTNET
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Optional override; the app defaults to its deployed NFT metadata URL.
# NEXT_PUBLIC_NFT_METADATA_URL=https://your-app.example/api/nft/metadata

# Permanent storage is opt-in. Also configure the separate Convex backend when
# intentionally enabling it. ARWEAVE_WALLET_KEY belongs on Convex, not here.
ARWEAVE_ENABLED=false

# Separate Convex environment (not populated by this file):
# SITE_URL: your app/auth redirect origin; Auth signing keys: see docs/SETUP.md.
# TIPPING_CONTRACT_ID and STELLAR_NETWORK: match the frontend tipping target.
# ARWEAVE_ENABLED and ARWEAVE_WALLET_KEY: only for intentional permanent uploads.
