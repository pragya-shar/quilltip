# Local Next.js environment. Copy to .env.local; keep real credentials out of Git.
# `bunx convex dev --once` writes these values for the selected dev deployment.
# Use a non-production deployment; see docs/SETUP.md ("Convex deployments").
# CONVEX_DEPLOYMENT=dev:your-deployment
# NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Network guard opt-in. `bun run dev`, `bun run guard:*`, and scripts that
# submit testnet transactions refuse to run without it. Use `testnet` for
# Stellar TESTNET, or `local` for LOCAL mode (a local standalone network and a
# local Convex backend only). See docs/SETUP.md ("Testnet guard").
# QUILLTIP_NETWORK_GUARD_OPT_IN=testnet

# TESTNET, or LOCAL for a local standalone network. Mainnet is refused.
NEXT_PUBLIC_STELLAR_NETWORK=TESTNET
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org
NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
# NEXT_PUBLIC_SOROBAN_RPC_URL is the earlier RPC name. If you still set it, it
# must equal NEXT_PUBLIC_STELLAR_RPC_URL.

# Payments v2 client (testnet): this deployment's contract set. Leave unset
# until the set exists; see docs/operations/payments-v2-cutover.md.
# NEXT_PUBLIC_CORE_CONTRACT_ID=
# NEXT_PUBLIC_TAB_CONTRACT_ID=
# The Article NFT contract; must equal the backend's NFT_CONTRACT_ID. Unset,
# the article NFT panel says minting and transfers are not available here.
# NEXT_PUBLIC_ARTICLE_NFT_CONTRACT_ID=
# NEXT_PUBLIC_TOKEN_CONTRACT_ID=

# WalletConnect (mobile wallets): a Reown project ID, 32 lowercase hex
# characters. Unset or blank turns mobile wallets off; any other value stops
# the build. Set it per deployment and in .env.local; never commit one. The
# Reown project must allow this deployment's origin (docs/wallets.md).
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Script and Stellar CLI values. Leave unset to use the NEXT_PUBLIC_* values.
# STELLAR_NETWORK=TESTNET
# STELLAR_RPC_URL=https://soroban-testnet.stellar.org
# NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# LOCAL mode (Stellar Quickstart `--local` and a local Convex backend run with
# `bun run dev:backend`; see docs/SETUP.md):
# QUILLTIP_NETWORK_GUARD_OPT_IN=local
# NEXT_PUBLIC_STELLAR_NETWORK=LOCAL
# NEXT_PUBLIC_STELLAR_RPC_URL=http://localhost:8000/soroban/rpc
# NEXT_PUBLIC_HORIZON_URL=http://localhost:8000
# NEXT_PUBLIC_NETWORK_PASSPHRASE="Standalone Network ; February 2017"
# NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3210

# Permanent storage is opt-in. Also configure the separate Convex backend when
# intentionally enabling it. ARWEAVE_WALLET_KEY belongs on Convex, not here.
ARWEAVE_ENABLED=false

# Optional product analytics (PostHog, EU). Off unless set to true. The key is
# server-only; events are relayed through /api/analytics after consent.
NEXT_PUBLIC_ANALYTICS_ENABLED=false
# ANALYTICS_POSTHOG_KEY=
# ANALYTICS_POSTHOG_HOST=https://eu.i.posthog.com

# Separate Convex environment (not populated by this file):
# SITE_URL: your app/auth redirect origin; Auth signing keys: see docs/SETUP.md.
# TIPPING_CONTRACT_ID and STELLAR_NETWORK: match the frontend tipping target.
# STELLAR_RPC_URL and NETWORK_PASSPHRASE: optional; the guard refuses mainnet
# values. HORIZON_URL: optional testnet Horizon override.
# ARWEAVE_ENABLED and ARWEAVE_WALLET_KEY: only for intentional permanent uploads.
# AUTH_RESEND_KEY and AUTH_EMAIL_FROM: password reset email (see docs/SETUP.md).
# Payments v2 chain layer (placeholders; see docs/SETUP.md "Payments v2"):
# CHAIN_V2_ENABLED=false gates v2 prepare functions until cutover.
# CHAIN_V1_PREPARES_ENABLED: unset or true keeps v1 tip and NFT preparation;
# false pauses it for the cutover while v1 verification continues.
# CHAIN_EPOCH names this deployment's v2 contract set, e.g. testnet-2026-12-01.
# CORE_CONTRACT_ID, TAB_CONTRACT_ID, NFT_CONTRACT_ID and TOKEN_CONTRACT_ID: the
# deployment's own contract set; TOKEN_CONTRACT_ID is the native XLM SAC.
# INDEXER_START_LEDGER: ledger of this set's Core deploy transaction.
# OPS_USER_IDS: comma-separated Convex user IDs that may read /ops/chain.
# INTERNAL_ACCOUNT_EMAIL_DOMAINS: optional, comma-separated email domains of
# internal (staff) accounts, e.g. example.com. Empty classifies nothing.
# Tab ledger: SETTLEMENT_ENABLED, TAB_DAILY_LIMIT and TAB_TIP_MAX (see
# docs/SETUP.md). TAB_ACCEPTOR_SECRET and TAB_SETTLER_SECRET are set only in the
# Convex dashboard.
