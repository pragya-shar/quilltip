{
  "name": "quilltip-app",
  "version": "1.2.0",
  "private": true,
  "scripts": {
    "check": "bun run format:check && bun run lint && bun run test:component-organization && bun run typecheck && bun run test:security && bun run build",
    "dev": "npm-run-all --parallel dev:frontend dev:backend",
    "dev:frontend": "next dev --turbopack",
    "dev:backend": "convex dev",
    "predev": "convex dev --until-success",
    "build": "next build",
    "analyze": "ANALYZE=true next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "test:component-organization": "node --test scripts/eslint/one-component-per-file.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test:e2e:eng-224": "playwright test e2e/eng-224-console.spec.ts",
    "eng-224:console-baseline": "node scripts/eng-224-console-baseline.mjs",
    "eng-235:batch-evidence": "bun scripts/eng-235-batch-evidence-runner.ts",
    "eng-236:batch-evidence": "bun scripts/eng-236-batch-evidence-runner.ts",
    "eng-238:page-load": "bun scripts/eng-238-page-load-performance.ts",
    "audit:dependencies": "bun run security:audit",
    "security:audit": "bun scripts/security/audit.ts",
    "test:security": "vitest run scripts/security/audit.test.ts"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,jsx,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
